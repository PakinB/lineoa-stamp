# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง — ห้าม commit .env.local
#
# ตอนนี้ต้องกรอกแค่ 4 ตัวแรกก็รันได้แล้ว
# ที่เหลืออยู่ใต้หัวข้อ "ยังไม่ต้องกรอกตอนนี้" ปล่อยว่างไว้ก่อนได้


# ══════════════════════════════════════════════════════════════════
#  ต้องกรอกตอนนี้ — 4 ตัว
# ══════════════════════════════════════════════════════════════════

# 1) ฐานข้อมูล
#    Supabase > Project Settings > Database > Connection string > URI
#    เลือกแบบ "Transaction pooler" ไม่ใช่ "Direct connection"
#    เพราะ Cloudflare Workers เปิด connection ค้างไว้ไม่ได้
#    (lib/db.ts ตั้ง prepare:false ไว้แล้วเพื่อให้ทำงานกับ pooler ได้)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 2) กุญแจเซ็นคุกกี้เซสชันพนักงาน — สร้างเอง ไม่ต้องไปขอที่ไหน
#    สร้างด้วย:  openssl rand -base64 48
#    ต้องยาวอย่างน้อย 32 ตัวอักษร ถ้าเปลี่ยนค่านี้ พนักงานทุกคนจะหลุดเซสชัน
SESSION_SECRET=

# 3) LIFF ID — ใช้สร้างลิงก์ในตัว QR
#    LINE Developers Console > ช่อง LINE Login > แท็บ LIFF > เพิ่ม LIFF app
#    หน้าตาแบบ 1656789012-AbCdEfGh (มีขีดกลาง)
#    ตั้ง Endpoint URL = https://<โดเมน>/card, Size = Full, เปิด Scan QR
NEXT_PUBLIC_LIFF_ID=

# 4) Channel ID ของ LINE Login — ใช้ตรวจว่า token ที่ลูกค้าส่งมาออกจากช่องของเราจริง
#    LINE Developers Console > ช่อง LINE Login > Basic settings > Channel ID
#    เป็นตัวเลขล้วน ๆ คนละอันกับ LIFF ID ข้างบน อย่าสับสน
#    ถ้าไม่ตรวจข้อนี้ ใครก็สร้าง channel ของตัวเองแล้วยิงเข้าระบบเราได้
LINE_LOGIN_CHANNEL_ID=


# ══════════════════════════════════════════════════════════════════
#  ยังไม่ต้องกรอกตอนนี้ — ใส่เมื่อทำฟีเจอร์นั้น
# ══════════════════════════════════════════════════════════════════

# สำหรับ: รับรูปใบเสร็จเดลิเวอรี่เข้าแชท + ส่งข้อความตอนถึง checkpoint
# LINE Developers Console > ช่อง Messaging API (คนละช่องกับ LINE Login)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# สำหรับ: เก็บรูปใบเสร็จเดลิเวอรี่
# Supabase > Project Settings > API  และสร้าง bucket ชื่อ receipts ไว้ก่อน
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=receipts

# สำหรับ: สร้าง URL เต็มในข้อความและ webhook
# ตอนพัฒนาใช้ ngrok หรือ Cloudflare Tunnel เพราะ LINE ไม่รับ http
NEXT_PUBLIC_BASE_URL=http://localhost:3000
