# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง — ห้าม commit .env.local

# ---------------------------------------------------------------- ฐานข้อมูล
# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# ------------------------------------------------------- LINE Login / LIFF
# LINE Developers Console > ช่อง LINE Login
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# ------------------------------------------------------ LINE Messaging API
# ใช้รับ webhook รูปใบเสร็จจากแชท และส่งข้อความตอนถึง checkpoint
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ------------------------------------------------------------ ที่เก็บไฟล์
# Supabase Storage — เก็บรูปใบเสร็จเดลิเวอรี่
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=receipts

# ----------------------------------------------------------------- ทั่วไป
# ใช้สร้างลิงก์ QR ต้องเป็น https ตอนใช้งานจริง
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------- เซสชันพนักงาน
# สุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร: openssl rand -base64 48
SESSION_SECRET=
